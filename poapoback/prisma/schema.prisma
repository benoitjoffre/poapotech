generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// ─────────────────────────────────────────────
// Tenant
// ─────────────────────────────────────────────
model Tenant {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String?
  // Libellé libre de l'activité
  industry     String   @default("")
  primaryColor String?  @default("#0d9488")
  logoUrl      String?
  quizTitle    String?  @default("Trouve ton produit idéal")
  ctaText      String?  @default("Découvrir ma sélection")
  embedDomain  String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  magicTokens  MagicToken[]
  products     Product[]
  quizzes      Quiz[]
  questions    Question[]
  sessions     QuizSession[]
  metrics      Metric[]
  campaigns    Campaign[]
}

model Quiz {
  id             String   @id @default(cuid())
  tenantId       String
  name           String
  // Libellé libre de l'activité
  industry       String   @default("")
  // Axes numériques de recommandation : [{ key, label, lowLabel?, highLabel? }], valeurs 0–1
  axes           Json     @default("[]")
  quizTitle      String
  ctaText        String
  active         Boolean  @default(true)
  isDefault      Boolean  @default(false)
  useAllProducts Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  questions      Question[]
  sessions       QuizSession[]
  metrics        Metric[]
  products       QuizProduct[]
  campaigns      Campaign[]

  @@unique([tenantId, id])
  @@index([tenantId])
}

// ─────────────────────────────────────────────
// Campaign — occasion marketing associée à un quiz existant
// ─────────────────────────────────────────────
model Campaign {
  id            String           @id @default(cuid())
  tenantId      String
  quizId        String
  name          String
  occasion      CampaignOccasion
  // Libellé libre, requis pour l'occasion CUSTOM
  occasionLabel String?
  description   String?
  objectives    String[]
  imageUrl      String?
  // Statut choisi par le tenant ; le statut affiché est calculé avec les dates
  status        CampaignStatus   @default(DRAFT)
  startsAt      DateTime?
  endsAt        DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Clé composite : une campagne ne peut référencer qu'un quiz de son propre tenant
  quiz          Quiz             @relation(fields: [tenantId, quizId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, quizId])
}

model QuizProduct {
  quizId    String
  productId String
  quiz      Quiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([quizId, productId])
  @@index([productId])
}

// ─────────────────────────────────────────────
// Auth
// ─────────────────────────────────────────────
model MagicToken {
  id        String   @id @default(cuid())
  tenantId  String
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
}

// ─────────────────────────────────────────────
// Product (catalogue)
// ─────────────────────────────────────────────
model Product {
  id            String    @id @default(cuid())
  tenantId      String
  name          String
  brand         String?
  description   String?
  price         Float?
  imageUrl      String?
  purchaseUrl   String?
  active        Boolean   @default(true)
  featured      Boolean   @default(false)
  tags          String[]
  // Caractéristiques propres à l'activité : valeurs des axes du quiz (0–1) et attributs libres
  attributes    Json      @default("{}")
  // AI embedding stored as JSON array (pgvector via raw SQL for queries)
  embedding     Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions      QuizSession[]
  quizzes       QuizProduct[]

  @@index([tenantId])
  @@index([tenantId, active])
}

// ─────────────────────────────────────────────
// Quiz — Questions & Answers
// ─────────────────────────────────────────────
model Question {
  id                String       @id @default(cuid())
  tenantId          String
  quizId            String
  text              String
  helpText          String?      // hint affiché sous la question
  type              QuestionType @default(single)
  imageUrl          String?      // illustration optionnelle
  order             Int          @default(0)
  active            Boolean      @default(true)
  // Conditional display: show only if a specific answer was selected
  conditionAnswerId String?      // null = always shown
  // A/B testing: assign question to a named variant ("A", "B", null = all)
  abVariant         String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quiz              Quiz         @relation(fields: [tenantId, quizId], references: [tenantId, id], onDelete: Cascade)
  answers           Answer[]     @relation("QuestionAnswers")
  conditionAnswer   Answer?      @relation("QuestionCondition", fields: [conditionAnswerId], references: [id], onDelete: SetNull)

  @@index([tenantId, order])
  @@index([quizId, order])
  @@index([conditionAnswerId])
}

model Answer {
  id         String     @id @default(cuid())
  questionId String
  text       String
  emoji      String?    // emoji ou icône courte
  imageUrl   String?    // image illustrant la réponse
  order      Int        @default(0)
  active     Boolean    @default(true)
  // Impacts sur les axes du quiz : { <clé d'axe>: delta }
  impacts    Json       @default("{}")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  question            Question   @relation("QuestionAnswers", fields: [questionId], references: [id], onDelete: Cascade)
  conditionalQuestion Question[] @relation("QuestionCondition")

  @@index([questionId])
}

// ─────────────────────────────────────────────
// Quiz Session
// ─────────────────────────────────────────────
model QuizSession {
  id              String    @id @default(cuid())
  tenantId        String
  quizId          String
  // Stored as JSON: [{ questionId, answerId }]
  answers         Json      @default("[]")
  resultProductId String?
  feedback        FeedbackType?
  feedbackReasons String[]
  decisionTime    Int?      // seconds
  abVariant       String?   // A/B variant assigned to this session
  completedAt     DateTime?
  createdAt       DateTime  @default(now())

  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quiz            Quiz      @relation(fields: [tenantId, quizId], references: [tenantId, id], onDelete: Cascade)
  resultProduct   Product?  @relation(fields: [resultProductId], references: [id])

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([quizId, createdAt])
}

// ─────────────────────────────────────────────
// Metrics (append-only event log)
// ─────────────────────────────────────────────
model Metric {
  id        String     @id @default(cuid())
  tenantId  String
  quizId    String
  type      MetricType
  payload   Json       @default("{}")
  createdAt DateTime   @default(now())

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quiz      Quiz       @relation(fields: [tenantId, quizId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, type])
  @@index([tenantId, createdAt])
  @@index([quizId, type, createdAt])
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────
enum QuestionType {
  single
  multi
  scale
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
}

enum CampaignOccasion {
  CHRISTMAS
  VALENTINES_DAY
  SPRING
  MOTHERS_DAY
  BACK_TO_SCHOOL
  BLACK_FRIDAY
  PROMOTION
  PERMANENT
  CUSTOM
}

enum FeedbackType {
  positive
  negative
}

enum MetricType {
  quiz_start
  quiz_complete
  quiz_abandon
  step_view
  step_answer
  buy_click
  feedback
  decision_time
}
