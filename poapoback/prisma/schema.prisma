generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// ─────────────────────────────────────────────
// Tenant
// ─────────────────────────────────────────────
model Tenant {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String?
  // Libellé libre de l'activité
  industry     String   @default("")
  primaryColor String?  @default("#6C47FF")
  logoUrl      String?
  quizTitle    String?  @default("Trouve ton produit idéal")
  ctaText      String?  @default("Découvrir ma sélection")
  embedDomain  String?
  active       Boolean  @default(true)
  // Plan commercial (entitlements, voir services/entitlements.ts) ; aucune limite n'est appliquée aujourd'hui.
  plan         String   @default("FREE")
  websiteUrl   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships   Membership[]
  magicTokens   MagicToken[]
  products      Product[]
  quizzes       Quiz[]
  questions     Question[]
  sessions      QuizSession[]
  metrics       Metric[]
  campaigns     Campaign[]
  catalogs      Catalog[]
  importBatches ImportBatch[]
}

// ─────────────────────────────────────────────
// Catalog — ensemble indépendant de produits d'un tenant
// Un seul catalogue par défaut par tenant : index partiel "Catalog_one_default_per_tenant" (SQL).
// ─────────────────────────────────────────────
model Catalog {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products      Product[]
  quizzes       Quiz[]
  importBatches ImportBatch[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@index([tenantId])
}

// ─────────────────────────────────────────────
// ImportBatch — idempotence des imports CSV (une ligne par tentative d'import)
// ─────────────────────────────────────────────
model ImportBatch {
  id          String   @id @default(cuid())
  tenantId    String
  catalogId   String
  // Clé d'idempotence fournie par le client, ou empreinte du contenu
  key         String
  // SHA-256 du catalogue, du mapping et des lignes
  fingerprint String
  status      String   @default("processing")
  result      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  catalog Catalog @relation(fields: [tenantId, catalogId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, catalogId, key])
  @@index([tenantId, catalogId, fingerprint])
}

model Quiz {
  id             String   @id @default(cuid())
  tenantId       String
  // Le quiz ne recommande que des produits de ce catalogue
  catalogId      String
  name           String
  // Libellé libre de l'activité
  industry       String   @default("")
  // Axes numériques de recommandation : [{ key, label, lowLabel?, highLabel? }], valeurs 0–1
  axes           Json     @default("[]")
  // Only controlled publication writes these overrides; drafts remain separate.
  publishedTheme Json?
  quizTitle      String
  ctaText        String
  active         Boolean  @default(true)
  isDefault      Boolean  @default(false)
  useAllProducts Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Clé composite : le catalogue appartient au même tenant que le quiz
  catalog     Catalog          @relation(fields: [tenantId, catalogId], references: [tenantId, id], onDelete: NoAction)
  questions   Question[]
  sessions    QuizSession[]
  metrics     Metric[]
  products    QuizProduct[]
  campaigns   Campaign[]
  editorDraft QuizEditorDraft?

  @@unique([tenantId, id])
  @@unique([catalogId, id])
  @@index([tenantId])
  @@index([tenantId, catalogId])
}

// A reset retains the row and increments revision to reject stale pre-reset writers.
model QuizEditorDraft {
  quizId    String   @id
  tenantId  String
  revision  Int      @default(1)
  content   Json?
  updatedAt DateTime @updatedAt

  quiz Quiz @relation(fields: [tenantId, quizId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, quizId])
  @@index([tenantId])
}

// ─────────────────────────────────────────────
// Campaign — occasion marketing associée à un quiz existant
// ─────────────────────────────────────────────
model Campaign {
  id            String           @id @default(cuid())
  tenantId      String
  quizId        String
  name          String
  occasion      CampaignOccasion
  // Libellé libre, requis pour l'occasion CUSTOM
  occasionLabel String?
  description   String?
  objectives    String[]
  imageUrl      String?
  // Statut choisi par le tenant ; le statut affiché est calculé avec les dates
  status        CampaignStatus   @default(DRAFT)
  startsAt      DateTime?
  endsAt        DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Clé composite : une campagne ne peut référencer qu'un quiz de son propre tenant
  quiz   Quiz   @relation(fields: [tenantId, quizId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, quizId])
}

// Sélection manuelle de produits : le quiz et le produit doivent partager le même catalogue (FK composites).
model QuizProduct {
  quizId    String
  productId String
  catalogId String
  quiz      Quiz    @relation(fields: [catalogId, quizId], references: [catalogId, id], onDelete: Cascade, onUpdate: Cascade)
  product   Product @relation(fields: [catalogId, productId], references: [catalogId, id], onDelete: Cascade, onUpdate: Cascade)

  @@id([quizId, productId])
  @@index([productId])
}

// ─────────────────────────────────────────────
// Auth
// ─────────────────────────────────────────────
model MagicToken {
  id        String   @id @default(cuid())
  tenantId  String
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
}

// ─────────────────────────────────────────────
// Product (catalogue)
// ─────────────────────────────────────────────
model Product {
  id          String   @id @default(cuid())
  tenantId    String
  catalogId   String
  name        String
  brand       String?
  description String?
  price       Float?
  imageUrl    String?
  purchaseUrl String?
  active      Boolean  @default(true)
  featured    Boolean  @default(false)
  tags        String[]
  // Caractéristiques propres à l'activité : valeurs des axes du quiz (0–1) et attributs libres
  attributes  Json     @default("{}")
  // AI embedding stored as JSON array (pgvector via raw SQL for queries)
  embedding   Json?
  // File persistante des embeddings : `embedding` est à jour seulement si embeddingStatus = READY.
  embeddingStatus        EmbeddingStatus @default(PENDING)
  // Incrémenté à chaque changement de contenu : un résultat calculé sur une version périmée est écarté.
  embeddingVersion       Int             @default(0)
  embeddingAttempts      Int             @default(0)
  embeddingError         String?
  embeddingNextAttemptAt DateTime?
  // Bail du traitement en cours : un traitement interrompu est repris une fois le bail expiré.
  embeddingLockedUntil   DateTime?
  embeddingUpdatedAt     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Clé composite : le catalogue appartient au même tenant que le produit
  catalog  Catalog       @relation(fields: [tenantId, catalogId], references: [tenantId, id], onDelete: NoAction)
  sessions QuizSession[]
  quizzes  QuizProduct[]

  @@unique([catalogId, id])
  @@index([tenantId])
  @@index([tenantId, active])
  @@index([tenantId, catalogId, active])
  @@index([embeddingStatus, embeddingNextAttemptAt])
}

// ─────────────────────────────────────────────
// Quiz — Questions & Answers
// ─────────────────────────────────────────────
model Question {
  id                String       @id @default(cuid())
  tenantId          String
  quizId            String
  text              String
  helpText          String? // hint affiché sous la question
  type              QuestionType @default(single)
  imageUrl          String? // illustration optionnelle
  order             Int          @default(0)
  active            Boolean      @default(true)
  // Conditional display: show only if a specific answer was selected
  conditionAnswerId String? // null = always shown
  // A/B testing: assign question to a named variant ("A", "B", null = all)
  abVariant         String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quiz            Quiz     @relation(fields: [tenantId, quizId], references: [tenantId, id], onDelete: Cascade)
  answers         Answer[] @relation("QuestionAnswers")
  conditionAnswer Answer?  @relation("QuestionCondition", fields: [conditionAnswerId], references: [id], onDelete: SetNull)

  @@index([tenantId, order])
  @@index([quizId, order])
  @@index([conditionAnswerId])
}

model Answer {
  id         String   @id @default(cuid())
  questionId String
  text       String
  emoji      String? // emoji ou icône courte
  imageUrl   String? // image illustrant la réponse
  order      Int      @default(0)
  active     Boolean  @default(true)
  // Impacts sur les axes du quiz : { <clé d'axe>: delta }
  impacts    Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  question            Question   @relation("QuestionAnswers", fields: [questionId], references: [id], onDelete: Cascade)
  conditionalQuestion Question[] @relation("QuestionCondition")

  @@index([questionId])
}

// ─────────────────────────────────────────────
// Quiz Session
// ─────────────────────────────────────────────
model QuizSession {
  id              String        @id @default(cuid())
  tenantId        String
  quizId          String
  // Stored as JSON: [{ questionId, answerId }]
  answers         Json          @default("[]")
  resultProductId String?
  feedback        FeedbackType?
  feedbackReasons String[]
  decisionTime    Int? // seconds
  abVariant       String? // A/B variant assigned to this session
  completedAt     DateTime?
  createdAt       DateTime      @default(now())

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quiz          Quiz     @relation(fields: [tenantId, quizId], references: [tenantId, id], onDelete: Cascade)
  resultProduct Product? @relation(fields: [resultProductId], references: [id])

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([quizId, createdAt])
}

// ─────────────────────────────────────────────
// Metrics (append-only event log)
// ─────────────────────────────────────────────
model Metric {
  id        String     @id @default(cuid())
  tenantId  String
  quizId    String
  type      MetricType
  payload   Json       @default("{}")
  createdAt DateTime   @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quiz   Quiz   @relation(fields: [tenantId, quizId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, type])
  @@index([tenantId, createdAt])
  @@index([quizId, type, createdAt])
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────
enum QuestionType {
  single
  multi
  scale
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
}

enum CampaignOccasion {
  CHRISTMAS
  VALENTINES_DAY
  SPRING
  MOTHERS_DAY
  BACK_TO_SCHOOL
  BLACK_FRIDAY
  PROMOTION
  PERMANENT
  CUSTOM
}

enum EmbeddingStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum FeedbackType {
  positive
  negative
}

enum MetricType {
  quiz_start
  quiz_complete
  quiz_abandon
  step_view
  step_answer
  buy_click
  feedback
  decision_time
}

// ─────────────────────────────────────────────
// Identité Auth0 : User (sub Auth0) ↔ Tenant via Membership.
// Un User n'a qu'une appartenance aujourd'hui (unique userId) ; le modèle autorise le multi-boutiques plus tard.
// ─────────────────────────────────────────────
enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

model User {
  id          String   @id @default(cuid())
  auth0Sub    String   @unique
  email       String
  createdAt   DateTime @default(now())
  lastLoginAt DateTime?

  memberships Membership[]
}

model Membership {
  id        String         @id @default(cuid())
  userId    String         @unique
  tenantId  String
  role      MembershipRole @default(OWNER)
  createdAt DateTime       @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}
